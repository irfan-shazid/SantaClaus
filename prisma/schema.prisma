generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Auth (Better Auth) ----------

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(USER)
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  orders        Order[]
  wishlistItems WishlistItem[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  issuer                String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ---------- Catalog ----------

enum ProductType {
  CLOTHING
  TOY
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  logoUrl   String
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("category")
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String
  price       Int
  images      String[]
  variants    String[]
  stock       Int         @default(0)
  type        ProductType
  featured    Boolean     @default(false)
  // Published by admin as a preview of what's coming; hidden from the regular shop
  // listing, users can add it to their wishlist instead of buying it.
  isUpcoming  Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  categoryId String
  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]
  wishlistItems WishlistItem[]

  @@index([categoryId])
  @@map("product")
}

// ---------- Wishlist (for upcoming/not-yet-released products) ----------

model WishlistItem {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("wishlist_item")
}

// ---------- Orders ----------

enum OrderStatus {
  PENDING
  CONFIRMED
  GIVEN_TO_RIDER
  DELIVERED
}

enum AddressZone {
  INSIDE_DHAKA
  OUTSIDE_DHAKA
}

enum AccountType {
  BKASH
  NAGAD
  ROCKET
}

model Order {
  id             String      @id @default(cuid())
  status         OrderStatus @default(PENDING)

  customerName   String
  phone          String
  address        String
  zone           AddressZone
  deliveryCharge Int

  accountType        AccountType @default(BKASH)
  bkashNumber        String
  transactionId      String
  deliveryChargePaid Boolean     @default(false)

  subtotal       Int
  total          Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@map("order")
}

model OrderItem {
  id String @id @default(cuid())
  // Nullable with SetNull so a product can be deleted without destroying order
  // history: the snapshot fields below keep the line item fully renderable on
  // its own, and nothing reads the product relation for display.
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName  String
  productImage String?
  variant      String?
  price        Int
  quantity     Int

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_item")
}

// ---------- Accounts (manual bookkeeping: costs + off-site income) ----------

enum AccountEntryType {
  COST
  EXTERNAL_INCOME
}

model AccountEntry {
  id        String           @id @default(cuid())
  type      AccountEntryType
  name      String
  amount    Int
  // The day this cost/income belongs to, stored as Bangladesh-midnight so it
  // always falls inside its own day when filtering by month or date range.
  date      DateTime
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([type, date])
  @@map("account_entry")
}

// ---------- Store settings (e.g. bKash receiving number) ----------

model Settings {
  id          String @id @default("store")
  bkashNumber String @default("01700000000")

  @@map("settings")
}
